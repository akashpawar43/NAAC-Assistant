# Server
PORT=8080
PUBLIC_URL=http://localhost:8080
# Only when the client is hosted on another origin than this API (see README, "Hosting the client
# separately"). Defaults to PUBLIC_URL. Sign-in redirects and collection links point here, and only
# this origin may call the API from a browser.
APP_URL=
# Session cookie SameSite: lax (default; also fine for app.example.in + api.example.in) or none (client
# and API on unrelated domains; needs an https PUBLIC_URL).
COOKIE_SAMESITE=lax
# Leave DATABASE_URL empty to use the embedded PGlite database in ./data/pgdata (dev). Never point a
# development setup at the production database: use a separate database for dev.
DATABASE_URL=
# Managed Postgres (e.g. Aiven): always verify the server certificate, with the CA certificate from
# the provider console. (sslmode=require with uselibpqcompat=true encrypts but does NOT check who the
# server is, so a man in the middle could read every query and the password; the server warns about it.)
# Connect as a role limited to this app's tables, not the provider's admin user (see README, "Database role").
# DATABASE_URL=postgres://naac_app:pass@host:port/defaultdb?sslmode=verify-full&sslrootcert=./ca.pem
PGLITE_DIR=./data/pgdata
# Where uploaded evidence and exports are stored (dev). R2/S3 can be plugged in via FileStore.
FILES_DIR=./data/files
# Magic-link email. Leave SMTP_HOST empty in dev: links are printed to the server log. Required in
# production (NODE_ENV=production): the server refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NAAC Assistant <no-reply@example.in>"
SESSION_DAYS=30
# A session also ends after this many days without use.
SESSION_IDLE_DAYS=14
# Which peers may set X-Forwarded-For (the client IP used for rate limits): comma-separated addresses,
# CIDRs or loopback / linklocal / uniquelocal, a hop count, or true/false. The default trusts only
# private networks, which covers Caddy in docker-compose. Never "true" when the app is reachable directly.
TRUST_PROXY=loopback,linklocal,uniquelocal
# Total evidence storage per workspace, in MB.
EVIDENCE_QUOTA_MB=2048
# Logging: LOG_LEVEL is fatal, error, warn, info (default), debug, trace or silent. LOG_FORMAT is pretty
# (default outside production) or json (default in production; one JSON object per line).
LOG_LEVEL=info
LOG_FORMAT=
# Swagger UI and the OpenAPI spec at /api/docs. On by default except in production, but only served
# when API_DOCS_PASSWORD is set: the browser then asks for API_DOCS_USER / API_DOCS_PASSWORD (HTTP Basic).
# Use a long random password (at least 12 characters), e.g. `openssl rand -base64 24`. After 10 wrong
# passwords an IP is locked out of the docs for 15 minutes.
API_DOCS=
API_DOCS_USER=docs
API_DOCS_PASSWORD=
